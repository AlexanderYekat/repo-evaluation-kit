{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository evaluation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "repositories"],
  "properties": {
    "goal": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^(?:https?|ssh)://[^\\s/@?#]+(?:/[^\\s?#]*)?$"}},
    "project_name": {"type": "string"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "current_state": {"type": "string"},
    "environment": {"type": "string"},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "avoid_building": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "scenarios": {"type": "array", "items": {"type": "string"}},
    "success_criteria": {"type": "array", "items": {"type": "string"}},
    "depth": {"type": "string", "enum": ["overview", "deep-static", "execution"], "default": "overview"},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "fetch_sources": {"type": "boolean", "default": false},
        "install_dependencies": {"type": "boolean", "default": false},
        "build": {"type": "boolean", "default": false},
        "run_tests": {"type": "boolean", "default": false},
        "start_services": {"type": "boolean", "default": false}
      }
    }
  }
}
